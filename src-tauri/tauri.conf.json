{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "huajing",
  "version": "0.3.1",
  "identifier": "com.huajing.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "化境",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "huajing",
    "shortDescription": "化境 — 本地优先的智能体角色扮演客户端",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5RDNBRjM1NENEM0MxClJXVEIwMHcxcjlPcEFKejFFdXN0R2pCcFh2TzN0TzlQLytCNFBHL2srQzZPYTc5NVhPWHdVRkU5Cg==",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
